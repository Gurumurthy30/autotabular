# Copy this file to .env and fill in real values. .env is already gitignored —
# never commit real keys.

# --- App & Database Configuration ---
PROJECTS_ROOT=projects
DATABASE_URL=sqlite:///app_metadata.db

# --- Ollama Cloud Configuration ---
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b

# --- LLM Context Window (tokens) ---
# Set this to match your model's max context. 16384 is a safe default.
# For gpt-oss:120b on Ollama Cloud you can go higher (32768 or 65536).
OLLAMA_NUM_CTX=16384

# --- MLflow Configuration ---
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- Optional LangSmith tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ML_agent
